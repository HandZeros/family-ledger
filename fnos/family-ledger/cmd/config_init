#!/bin/bash
# 配置变更前：校验端口
PORT="${wizard_port:-}"
if [ -n "${PORT}" ]; then
    case "${PORT}" in
        ''|*[!0-9]*)
            echo "端口必须是数字" > "${TRIM_TEMP_LOGFILE}"
            exit 1
            ;;
    esac
    if [ "${PORT}" -lt 1024 ] || [ "${PORT}" -gt 65535 ]; then
        echo "端口需在 1024-65535 之间（1024 以下为系统保留端口）" > "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi
fi
exit 0
